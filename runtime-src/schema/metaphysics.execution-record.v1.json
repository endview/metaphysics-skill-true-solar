{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaphysics.execution-record.v1",
  "$comment": "Current implementation contract; semantic and source validation is performed by the versioned runtime validators, not JSON Schema alone.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "metaphysics.execution-record.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "minLength": 1
    },
    "dependency_digest": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "minLength": 1
    },
    "method_input_digest": {
      "type": "string",
      "minLength": 1
    },
    "frozen_case_digest": {
      "type": "string",
      "minLength": 1
    },
    "output_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_output_digest": {
      "type": "string",
      "minLength": 1
    },
    "stderr_digest": {
      "type": "string",
      "minLength": 1
    },
    "output_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "timed_out": {
      "type": "boolean"
    },
    "output_limited": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": "string",
      "minLength": 1
    },
    "retry_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": "object"
    },
    "observation": {
      "type": "object",
      "properties": {
        "level": {
          "const": "local_runner_observed"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "host_tool_ref": {
          "type": "null"
        }
      },
      "required": [
        "level",
        "source",
        "host_tool_ref"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "source_unchanged_during_run": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "run_id",
    "case_id",
    "revision",
    "task_id",
    "method",
    "attempt",
    "entrypoint",
    "source_digest",
    "dependency_digest",
    "input_digest",
    "method_input_digest",
    "frozen_case_digest",
    "output_digest",
    "raw_output_digest",
    "stderr_digest",
    "output_ref",
    "exit_code",
    "signal",
    "timed_out",
    "output_limited",
    "started_at",
    "ended_at",
    "retry_reason",
    "environment",
    "observation",
    "metrics",
    "validation",
    "source_unchanged_during_run"
  ],
  "additionalProperties": false
}
