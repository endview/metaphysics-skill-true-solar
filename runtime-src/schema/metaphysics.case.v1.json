{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaphysics.case.v1",
  "$comment": "Current implementation contract; semantic and source validation is performed by the versioned runtime validators, not JSON Schema alone.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "metaphysics.case.v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "draft",
        "awaiting_input",
        "frozen",
        "executing",
        "calculated",
        "validated",
        "interpreted",
        "delivered",
        "observed",
        "closed",
        "execution_failed",
        "validation_failed",
        "superseded",
        "invalidated"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "event_ref": {
      "type": "string",
      "minLength": 1
    },
    "proposition_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "string",
      "minLength": 1
    },
    "analysis_scope": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object"
    },
    "time_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidates": {
      "type": "array"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "rule_profile": {
            "type": "string",
            "minLength": 1
          },
          "method_inputs": {
            "type": "object"
          }
        },
        "required": [
          "task_id",
          "method",
          "rule_profile",
          "method_inputs"
        ],
        "additionalProperties": false
      }
    },
    "history": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "case_id",
    "revision",
    "state",
    "subject_ref",
    "event_ref",
    "proposition_id",
    "question",
    "criteria",
    "analysis_scope",
    "window",
    "time_context",
    "candidates",
    "tasks",
    "history"
  ],
  "additionalProperties": false
}
