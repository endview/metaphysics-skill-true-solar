{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaphysics.interpretation-draft.v1",
  "type": "object",
  "properties": {
    "binding": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "event_ref": {
          "type": "string",
          "minLength": 1
        },
        "proposition_id": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "string",
          "minLength": 1
        },
        "window_digest": {
          "type": "string",
          "minLength": 1
        },
        "analysis_scope": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "case_id",
        "task_id",
        "method",
        "subject_ref",
        "event_ref",
        "proposition_id",
        "criteria",
        "window_digest",
        "analysis_scope",
        "revision"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "ok",
        "insufficient_input",
        "error"
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "nature",
          "binding",
          "text",
          "basis_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "nature": {
            "enum": [
              "calculation_fact",
              "traditional_interpretation",
              "real_world_fact",
              "action_recommendation"
            ]
          },
          "binding": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "subject_ref": {
                "type": "string",
                "minLength": 1
              },
              "event_ref": {
                "type": "string",
                "minLength": 1
              },
              "proposition_id": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "string",
                "minLength": 1
              },
              "window_digest": {
                "type": "string",
                "minLength": 1
              },
              "analysis_scope": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "case_id",
              "task_id",
              "method",
              "subject_ref",
              "event_ref",
              "proposition_id",
              "criteria",
              "window_digest",
              "analysis_scope",
              "revision"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "basis_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "binding",
    "status",
    "claims"
  ],
  "additionalProperties": false
}
