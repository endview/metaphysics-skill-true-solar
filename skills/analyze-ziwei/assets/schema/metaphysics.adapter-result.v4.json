{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaphysics.adapter-result.v4",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "metaphysics.adapter-result.v4"
    },
    "method_id": {
      "enum": [
        "bazi",
        "ziwei",
        "meihua"
      ]
    },
    "skill_name": {
      "enum": [
        "$analyze-bazi",
        "$analyze-ziwei",
        "$cast-meihua"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "insufficient_input",
        "error"
      ]
    },
    "question_answered": {
      "type": "string",
      "minLength": 1
    },
    "applicable_time_scale": {
      "enum": [
        "structural",
        "multi_year_stage",
        "annual_cycle",
        "bounded_event",
        "unknown"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions_and_uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "follow_up_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "proposition_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "supportive",
              "cautionary",
              "mixed",
              "neutral",
              "unknown"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicable_time_scale": {
            "enum": [
              "structural",
              "multi_year_stage",
              "annual_cycle",
              "bounded_event",
              "unknown"
            ]
          },
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "claim_id",
          "proposition_id",
          "subject_ref",
          "statement",
          "direction",
          "conditions",
          "applicable_time_scale",
          "basis_refs"
        ],
        "additionalProperties": false
      }
    },
    "method_payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "event_ref": {
          "type": "string",
          "minLength": 1
        },
        "proposition_id": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "string",
          "minLength": 1
        },
        "window_digest": {
          "type": "string",
          "minLength": 1
        },
        "analysis_scope": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "case_id",
        "task_id",
        "method",
        "subject_ref",
        "event_ref",
        "proposition_id",
        "criteria",
        "window_digest",
        "analysis_scope",
        "revision"
      ],
      "additionalProperties": false
    },
    "execution_ref": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "object"
    },
    "claim_provenance": {
      "type": "array"
    },
    "receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "fact_block": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "method_id",
    "skill_name",
    "status",
    "question_answered",
    "applicable_time_scale",
    "findings",
    "basis",
    "assumptions_and_uncertainty",
    "limitations",
    "follow_up_needed",
    "claims",
    "method_payload",
    "binding",
    "execution_ref",
    "validation",
    "claim_provenance",
    "receipt_ref",
    "fact_block"
  ],
  "additionalProperties": false
}
